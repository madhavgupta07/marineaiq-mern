# Copy to server/.env
PORT=5000
JWT_SECRET=replace-with-a-long-random-string
CLIENT_URL=http://localhost:5173
COOKIE_SAMESITE=lax

# Optional. Without this, the API uses a local JSON file (server/data/db.json)
# so you can run and demo the whole app immediately. Add it to use MongoDB.
MONGO_URI=mongodb://127.0.0.1:27017/marineaiq

# Bootstrap admin created by `npm run seed`
ADMIN_EMAIL=admin@marineaiq.local
ADMIN_PASSWORD=change-me-now
