{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run install:all && npm run build",
  "builds": [
    {
      "src": "server/src/app.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["client/dist/**"]
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/src/app.js" },
    { "src": "/(.*)", "dest": "server/src/app.js" }
  ]
}
